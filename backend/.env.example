# ============================================================
# Berbera Smart House Numbering System — Backend Environment
# Copy this file to .env and fill in your values
# ============================================================

# Server
PORT=4000
NODE_ENV=production

# Supabase (get from https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Authentication (admin dashboard)
JWT_SECRET=change-this-to-a-long-random-secret-string
JWT_EXPIRES_IN=24h

# Admin credentials (CHANGE BEFORE DEPLOYMENT)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Berbera@2024!

# CORS — allowed frontend origins
CORS_ORIGIN=http://localhost:3000,https://your-vercel-domain.vercel.app

# OSRM (routing engine) — uses public demo; replace with self-hosted for production
OSRM_URL=https://router.project-osrm.org
