# ────────────────────────────────────────────────────────────
# AI Pipeline Environment Variables
# Copy to .env and fill in your values
# ────────────────────────────────────────────────────────────

# Supabase (SERVICE ROLE key for write access)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Mapbox token for high-res satellite tiles
# MAPBOX_TOKEN=pk.eyJ1Ijoi...

# Detection settings (overridden by CLI args)
ZOOM_LEVEL=16
CONF_THRESHOLD=0.25
